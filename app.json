{
  "expo": {
    "name": "Wayamesh",
    "slug": "wayamesh-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/wayamesh-w-mint.png",
      "resizeMode": "contain",
      "backgroundColor": "#07070F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wayamesh.mobile",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Wayamesh uses Bluetooth to relay payments over mesh networks without internet.",
        "NSBluetoothPeripheralUsageDescription": "Wayamesh uses Bluetooth to relay payments over mesh networks without internet.",
        "NSFaceIDUsageDescription": "Wayamesh uses Face ID to protect your wallet.",
        "NSCameraUsageDescription": "Wayamesh uses the camera to scan recipient wallet addresses."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07070F"
      },
      "package": "com.wayamesh.mobile",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ]
    },
    "scheme": "wayamesh",
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07070F",
          "image": "./assets/wayamesh-w-mint.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Wayamesh uses Face ID to protect your wallet."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de5243ef-44ee-472f-8322-f928b3013f0a"
      }
    },
    "owner": "tevinprime66"
  }
}
