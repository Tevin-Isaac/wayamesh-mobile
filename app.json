{
  "expo": {
    "name": "Wayamesh",
    "slug": "wayamesh-mobile",
    "version": "1.1.0-beta.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/wayamesh-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#07070F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wayamesh.mobile",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Wayamesh can use Bluetooth to hand offline payments and messages to a nearby Wayamesh phone. Bluetooth hand-off with iPhone is send-only; receiving needs an Android phone.",
        "NSFaceIDUsageDescription": "Wayamesh uses Face ID to protect your wallet.",
        "NSCameraUsageDescription": "Wayamesh uses the camera to scan payment, contact and message QR codes.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "2",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07070F"
      },
      "package": "com.wayamesh.mobile",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ],
      "versionCode": 2
    },
    "scheme": "wayamesh",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Wayamesh uses the camera to scan payment, contact and message QR codes."
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07070F",
          "image": "./assets/wayamesh-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Wayamesh uses Face ID to protect your wallet."
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [],
          "bluetoothAlwaysPermission": "Wayamesh can use Bluetooth to hand offline payments and messages to a nearby Wayamesh phone."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de5243ef-44ee-472f-8322-f928b3013f0a"
      }
    },
    "owner": "tevinprime66",
    "runtimeVersion": "1.1.0",
    "updates": {
      "url": "https://u.expo.dev/de5243ef-44ee-472f-8322-f928b3013f0a",
      "fallbackToCacheTimeout": 0
    }
  }
}
